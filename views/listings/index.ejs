<% layout('layouts/boilerplate') -%>
<body>
   
    <div class="filters-wrapper">
      <div class="filters-row d-flex align-items-center px-3">
        <!-- Scroll Left Button -->
        <button id="scroll-left" class="scroll-btn me-2" aria-label="Scroll Left">
          &laquo;
        </button>
    
        <!-- Scrollable Filters -->
        <div class="filters-container flex-grow-1" id="filters-scroll">
          <!-- Filters -->
          <% for(let c of categories){ %>
            <% const isActive = category === c.value; %>
            <% const params = new URLSearchParams(); %>
            <% if(!isActive) params.set("category", c.value); %>
            <% if(q) params.set("q", q); %>
            <a href="/listings<%= params.toString() ? "?" + params.toString() : "" %>" class="filter<%= isActive ? " active" : "" %>">
              <div><i class="<%= c.icon %>"></i></div>
              <p><%= c.label %></p>
            </a>
          <% } %>
        </div>
    
        <!-- Scroll Right Button -->
        <button id="scroll-right" class="scroll-btn ms-2" aria-label="Scroll Right">
          &raquo;
        </button>
        <!-- Tax toggle -->
      <div class="tax-toggle">
        <div class="form-check form-switch ms-auto">
          <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
          <label class="form-check-label" for="flexSwitchCheckDefault">Display total after Taxes</label>
        </div>
      </div>
      </div>
    </div>

    <% if(allListings.length === 0){ %>
      <div class="text-center mt-5">
        <h5>No listings found</h5>
        <p class="text-muted">Try a different search or <a href="/listings">view all listings</a>.</p>
      </div>
    <% } %>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 row-cols-1 mt-3">
        <% for(let listing of allListings){ %>
            <a href="/listings/<%= listing._id %>" class="listing-link">
                <div class="card col listing-card" >
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem;">
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                      <p class="card-text">
                        <b><%= listing.title %></b> <br>
                        &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                        <i class="tax-info"> +18% GST</i>
                      </p>
                    </div>
                </div>
            </a>
        <% } %>
    </div>
     <script src="/js/filter.js"></script>
</body>


